---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <h1 class="text-2xl">Simple Olympians</h1>
  <div class="p-2">
    <a href="/">Accueil</a>
  </div>
  <div id="myplot"></div>
  <script>
    import * as Plot from "@observablehq/plot";
    import olympians from "../assets/olympians.json";

    const plot = Plot.plot({
      marks: [
        Plot.dot(olympians, {
          x: "height",
          y: "weight",
          stroke: "nationality",
        }),
      ],
    });

    const div = document.querySelector("#myplot");
    div?.append(plot);
  </script>
</Layout>
