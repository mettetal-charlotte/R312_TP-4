---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <h1 class="text-2xl">Simple Penguins</h1>
  <div>
    <a href="/">Accueil</a>
  </div>
  <div id="myplot"></div>
  <script>
    import * as Plot from "@observablehq/plot";
    import penguins from "../assets/penguins.json";

    const plot = Plot.plot({
      marks: [
        Plot.dot(penguins, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
          stroke: "species",
        }),
      ],
    });

    const div = document.querySelector("#myplot");
    div?.append(plot);
  </script>
</Layout>
