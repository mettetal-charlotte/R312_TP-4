---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <h1 class="text-2xl">Pizza avec filtre</h1>
  <div>
    <a href="/">Accueil</a>
  </div>
  <div id="myplot"></div>
  <select name="nationality" id="nationality">
    <option value="">All category</option>
    <option value="ESP">Espagnol</option>
    <option value="CAN">Canadienne</option>
    <option value="AUS">Australienne</option>
    <option value="USA">Américaine</option>
  </select>
  <script>
    import * as Plot from "@observablehq/plot";
    import olympians from "../assets/olympians.json";

    const selectNationality: HTMLInputElement =
      document.querySelector("#nationality")!;
    function affiche() {
      const nationality = selectNationality.value;
      const plot = Plot.plot({
        marks: [
          Plot.dot(olympians, {
            x: "height",
            y: "weight",
            stroke: "nationality",
            filter: (p) => p.nationality === nationality || !nationality,
          }),
        ],
      });

      const div = document.querySelector("#myplot");
      ((div.innerHTML = ""), div?.append(plot));
    }

    selectNationality.addEventListener("change", affiche);
    affiche();
  </script>
</Layout>
